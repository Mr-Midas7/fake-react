{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/client"
      }
    },
    {
      "src": "dist/server/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/server/assets"]
      }
    }
  ],
 "routes": [
    {
      "src": "/(.*)",
      "dest": "/dist/server/server.js"
    }
  ]
}
